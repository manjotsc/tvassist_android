<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules). Back up everything EXCEPT the HA credentials
     store for both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/tv_assist_credentials.preferences_pb" />
        <exclude domain="file" path="tv_setup_cert.p12" />
        <!-- The HA-page overlay writes the frontend's auth blob into WebView localStorage. -->
        <exclude domain="file" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/tv_assist_credentials.preferences_pb" />
        <exclude domain="file" path="tv_setup_cert.p12" />
        <!-- The HA-page overlay writes the frontend's auth blob into WebView localStorage. -->
        <exclude domain="file" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
