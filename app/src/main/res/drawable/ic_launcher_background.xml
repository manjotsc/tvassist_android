<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the HA-blue gradient filling the whole 108x108 tile, so the icon is
     full-bleed (no dark bars) whatever mask shape the launcher applies. The toggle lives in the
     foreground layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="76" android:endY="108">
                <item android:offset="0" android:color="#FF5FD8FF" />
                <item android:offset="1" android:color="#FF0E9AD6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
