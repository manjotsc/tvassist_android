<?xml version="1.0" encoding="utf-8"?>
<!-- In-app brand mark shown next to the app name on the home rail. Full-bleed gradient tile with
     the TVAssist toggle; the composable clips the corners. Same mark as the launcher icon/banner. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0 H100 V100 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="70" android:endY="100">
                <item android:offset="0" android:color="#FF5FD8FF" />
                <item android:offset="1" android:color="#FF0E9AD6" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#FFFFFFFF" android:pathData="M35,35 H65 A15,15 0 0 1 80,50 V50 A15,15 0 0 1 65,65 H35 A15,15 0 0 1 20,50 V50 A15,15 0 0 1 35,35 Z" />
    <path android:fillColor="#FF0E9AD6" android:pathData="M53,50 a12,12 0 1 0 24,0 a12,12 0 1 0 -24,0 Z" />
</vector>
